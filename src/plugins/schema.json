      "id": "capacity",
      "title": "Capacity Settings",
      "if": {
        "properties": {
          "capacityModel": {
            "const": "Status-based"
          }
        }
      },
      "then": {
        "required": ["statusField", "valuesForInProgress"]
      },
      "else": {
        "not": {
          "required": ["statusField", "valuesForInProgress"]
        }
      },
      "type": "object",
      "properties": {
        "capacityModel": {
          "title": "Capacity Model",
          "description": "Choose the service channel Capacity Model",
          "type": "string",
          "enum": ["TabBased", "StatusBased"]
        },
        "statusField": {
