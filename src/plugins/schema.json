{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Browserforce Configuration",
  "description": "The browserforce config file contains the configuration values that defines browser automation tasks for Salesforce orgs.",
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "properties": {
        "activitySettings": {
          "allOf": [
            {
              "$ref": "#/definitions/activitySettings"
            }
          ]
        },
        "authProviders": {
          "allOf": [
            {
              "$ref": "#/definitions/authProviders"
            }
          ]
        },
        "companyInformation": {
          "allOf": [
            {
              "$ref": "#/definitions/companyInformation"
            }
          ]
        },
        "customerPortal": {
          "allOf": [
            {
              "$ref": "#/definitions/customerPortal"
            }
          ]
        },
        "densitySettings": {
          "allOf": [
            {
              "$ref": "#/definitions/densitySettings"
            }
          ]
        },
        "emailDeliverability": {
          "allOf": [
            {
              "$ref": "#/definitions/emailDeliverability"
            }
          ]
        },
        "externalStorageSettings": {
          "allOf": [
            {
              "$ref": "#/definitions/externalStorageSettings"
            }
          ]
        },
        "highVelocitySalesSettings": {
          "allOf": [
            {
              "$ref": "#/definitions/highVelocitySalesSettings"
            }
          ]
        },
        "historyTracking": {
          "title": "History Tracking",
          "description": "This feature specifically closes a gap where you cannot enable field history tracking for custom Person Account fields via the Metadata API.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/historyTracking"
          }
        },
        "homePageLayouts": {
          "allOf": [
            {
              "$ref": "#/definitions/homePageLayouts"
            }
          ]
        },
        "lightningExperienceSettings": {
          "allOf": [
            {
              "$ref": "#/definitions/lightningExperienceSettings"
            }
          ]
        },
        "listViewCustomButtons": {
          "title": "List View Custom Buttons",
          "description": "Manage the selected custom buttons in the list view button layout (Aloha Search Layout) for any object. Buttons are identified by their WebLink API Name (DeveloperName), with optional namespace prefix (e.g. 'AssignTask' or 'th_dev__AssignTask').",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/listViewCustomButtons"
          }
        },
        "linkedInSalesNavigatorSettings": {
          "allOf": [
            {
              "$ref": "#/definitions/linkedInSalesNavigatorSettings"
            }
          ]
        },
        "loginAsUser": {
          "title": "Login As User",
          "description": "Login as another user using the Salesforce Login As (servlet.su) functionality",
          "allOf": [
            {
              "$ref": "#/definitions/loginAsUser"
            }
          ]
        },
        "logoutLoginAsUser": {
          "title": "Logout Login As User",
          "description": "Log out from the current Login As session by opening the logout page",
          "allOf": [
            {
              "$ref": "#/definitions/logoutLoginAsUser"
            }
          ]
        },
        "omniChannelSettings": {
          "allOf": [
            {
              "$ref": "#/definitions/omniChannelSettings"
            }
          ]
        },
        "opportunitySplits": {
          "allOf": [
            {
              "$ref": "#/definitions/opportunitySplits"
            }
          ]
        },
        "permissionSets": {
          "title": "Permission Sets",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/permissionSet"
          }
        },
        "picklists": {
          "allOf": [
            {
              "$ref": "#/definitions/picklists"
            }
          ]
        },
        "providerSearchSettings": {
          "title": "Provider Search Settings",
          "description": "Generate Data Processing Engine (DPE) definition for Provider Search from Setup when not already active.",
          "allOf": [
            {
              "$ref": "#/definitions/providerSearchSettings"
            }
          ]
        },
        "recordTypes": {
          "allOf": [
            {
              "$ref": "#/definitions/recordTypes"
            }
          ]
        },
        "relateContactToMultipleAccounts": {
          "allOf": [
            {
              "$ref": "#/definitions/relateContactToMultipleAccounts"
            }
          ]
        },
        "reportsAndDashboards": {
          "allOf": [
            {
              "$ref": "#/definitions/reportsAndDashboards"
            }
          ]
        },
        "scheduledBatches": {
          "title": "Scheduled Batches",
          "description": "Schedule batch jobs by checking the Scheduled checkboxes on the Batch Job Scheduler Configuration page. When jobScheduleNames is omitted, all checkboxes are checked.",
          "allOf": [
            {
              "$ref": "#/definitions/scheduledBatches"
            }
          ]
        },
        "salesforceCpqConfig": {
          "allOf": [
            {
              "$ref": "#/definitions/salesforceCpqConfig"
            }
          ]
        },
        "salesforceToSalesforce": {
          "allOf": [
            {
              "$ref": "#/definitions/salesforceToSalesforce"
            }
          ]
        },
        "security": {
          "allOf": [
            {
              "$ref": "#/definitions/security"
            }
          ]
        },
        "serviceChannels": {
          "title": "Service Channels",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/serviceChannel"
          }
        },
        "slack": {
          "allOf": [
            {
              "$ref": "#/definitions/slack"
            }
          ]
        },
        "userAccessPolicies": {
          "allOf": [
            {
              "$ref": "#/definitions/userAccessPolicies"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["settings"],
  "definitions": {
    "activitySettings": {
      "id": "activitySettings",
      "title": "Activity Settings",
      "type": "object",
      "properties": {
        "allowUsersToRelateMultipleContactsToTasksAndEvents": {
          "title": "Allow Users to Relate Multiple Contacts to Tasks and Events",
          "description": "Although the Metadata API has a ActivitiesSettings.allowUsersToRelateMultipleContactsToTasksAndEvents field, it is not possible to enable this setting using an API. Warning: can only be disabled with help of the salesforce.com Support team. https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_activitiessettings.htm",
          "type": "boolean"
        }
      }
    },
    "authProviders": {
      "description": "Configuration for updating Auth Provider Consumer Key and Consumer Secret",
      "id": "authProviders",
      "title": "Auth Providers",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "consumerSecret": {
            "title": "Consumer Secret",
            "description": "The Consumer Secret value for the Auth Provider",
            "x-password": true,
            "type": "string"
          },
          "consumerKey": {
            "title": "Consumer Key",
            "description": "The Consumer Key value for the Auth Provider",
            "type": "string"
          }
        }
      }
    },
    "companyInformation": {
      "description": "",
      "id": "companyInformation",
      "title": "Company Information",
      "type": "object",
      "properties": {
        "defaultCurrencyIsoCode": {
          "title": "Default Currency",
          "type": "string"
        }
      }
    },
    "customerPortal": {
      "description": "Only available in Salesforce Classic UI",
      "id": "customerPortal",
      "title": "Customer Portal Settings",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enable Customer Portal",
          "description": "Although the Metadata API has a OrgSettings.enableCustomerSuccessPortal field, enabling this via the browser can be handy because it automatically creates a Portal named 'Customer Portal', where the admin and emailSenderAddress are set to the current user. Warning: cannot be disabled once enabled",
          "type": "boolean"
        },
        "portals": {
          "title": "Portals",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/portal"
          }
        },
        "availableCustomObjects": {
          "title": "Custom Objects available for Customer Portal",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/availableCustomObject"
          }
        }
      }
    },
    "portal": {
      "id": "portal",
      "type": "object",
      "properties": {
        "adminUser": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "isSelfRegistrationActivated": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "oldName": {
          "type": "string"
        },
        "selfRegUserDefaultLicense": {
          "type": "string"
        },
        "selfRegUserDefaultProfile": {
          "type": "string"
        },
        "selfRegUserDefaultRole": {
          "type": "string"
        },
        "portalProfileMemberships": {
          "description": "Profiles for which this portal should be activated or deactivated",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/portalProfileMembership"
          }
        }
      },
      "required": ["name"]
    },
    "portalProfileMembership": {
      "id": "portalProfileMembership",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "availableCustomObject": {
      "id": "availableCustomObject",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespacePrefix": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": ["name", "available"]
    },
    "densitySettings": {
      "id": "densitySettings",
      "title": "Density Settings",
      "type": "object",
      "properties": {
        "density": {
          "title": "Density",
          "description": "Choose the default display setting for your org",
          "type": "string",
          "enum": ["Comfy", "Compact"]
        }
      }
    },
    "emailDeliverability": {
      "id": "emailDeliverability",
      "title": "Email Deliverability Settings",
      "type": "object",
      "properties": {
        "accessLevel": {
          "title": "Access Level",
          "description": "Choose the email Deliverability Access Level required",
          "type": "string",
          "enum": ["No access", "System email only", "All email"]
        }
      }
    },
    "externalStorageSettings": {
      "id": "externalStorageSettings",
      "title": "External Storage Settings",
      "type": "object",
      "properties": {
        "enable": {
          "title": "Toggle names to enable",
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["AccessFilesInAmazonS3", "UploadFilesToAmazonS3"]
          }
        },
        "disable": {
          "title": "Toggle names to disable",
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["AccessFilesInAmazonS3", "UploadFilesToAmazonS3"]
          }
        }
      }
    },
    "highVelocitySalesSettings": {
      "description": "Due to a bug, High Velocity Sales needs to be set up and enabled initially using the UI.\nOnce set up, it can be configured using HighVelocitySalesSettings Metadata https://developer.salesforce.com/docs/atlas.en-us.api_meta.meta/api_meta/meta_highvelocitysalessettings.htm",
      "id": "highVelocitySalesSettings",
      "title": "HighVelocitySalesSettings",
      "type": "object",
      "properties": {
        "setUpAndEnable": {
          "title": "Set Up and Enable High Velocity Sales",
          "type": "boolean"
        }
      }
    },
    "historyTracking": {
      "id": "historyTracking",
      "type": "object",
      "properties": {
        "objectApiName": {
          "title": "Object API Name",
          "description": "The API name of the object to manage history tracking for.",
          "type": "string"
        },
        "enableHistoryTracking": {
          "title": "Enable History Tracking",
          "description": "If history tracking should be enabled.",
          "type": "boolean"
        },
        "fieldHistoryTracking": {
          "title": "Field History Tracking",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/fieldHistory"
          }
        }
      },
      "required": ["objectApiName"]
    },
    "fieldHistory": {
      "id": "fieldHistory",
      "type": "object",
      "properties": {
        "fieldApiName": {
          "title": "Field API Name",
          "description": "The API name of the field to manage history tracking for.",
          "type": "string"
        },
        "enableHistoryTracking": {
          "title": "Enable History Tracking",
          "description": "If history tracking should be enabled.",
          "type": "boolean"
        }
      },
      "required": ["fieldApiName", "enableHistoryTracking"]
    },
    "homePageLayouts": {
      "description": "Assign Home Page Layouts for Profiles. Only available in Salesforce Classic UI",
      "id": "homePageLayouts",
      "title": "Home Page Layouts",
      "type": "object",
      "properties": {
        "homePageLayoutAssignments": {
          "title": "Home Page Layout Assignment",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/homePageLayoutAssignment"
          }
        }
      }
    },
    "homePageLayoutAssignment": {
      "id": "homePageLayoutAssignment",
      "type": "object",
      "properties": {
        "profile": {
          "description": "Developer Name of Profile",
          "type": "string"
        },
        "layout": {
          "description": "Developer Name of the HomePageLayout or empty string for default layout",
          "type": "string"
        }
      },
      "required": ["profile", "layout"]
    },
    "lightningExperienceSettings": {
      "description": "Although the Metadata API has a field activeThemeName in LightningExperienceSettings it's not possible to activate any of the standard themes like Lightning and LightningLite or SalesforceCosmos.",
      "id": "lightningExperienceSettings",
      "title": "LightningExperienceSettings",
      "type": "object",
      "properties": {
        "activeThemeName": {
          "title": "The active Lightning Experience Theme",
          "description": "The API Name of the Lightning Experience Theme to be activated",
          "type": "string"
        }
      }
    },
    "listViewCustomButtons": {
      "id": "listViewCustomButtons",
      "type": "object",
      "properties": {
        "objectApiName": {
          "title": "Object API Name",
          "description": "The API name of the object whose list view custom buttons to manage (e.g. Activity, Account, Contact).",
          "type": "string"
        },
        "buttons": {
          "title": "Buttons",
          "description": "WebLink API Names (DeveloperName) of the custom buttons to select. Use namespace__Name for namespaced buttons (e.g. 'th_dev__AssignTask') or just Name for unpackaged buttons (e.g. 'AssignTask').",
          "default": [],
          "type": "array",
          "items": {
            "description": "WebLink API Name (DeveloperName) of the custom button, optionally prefixed with namespace (e.g. 'AssignTask' or 'th_dev__AssignTask').",
            "type": "string"
          }
        },
        "removeOtherButtons": {
          "title": "Remove Other Buttons",
          "description": "Whether to remove other buttons from the list view. If true, all buttons except the ones specified in the buttons array will be removed.",
          "default": false,
          "type": "boolean"
        }
      },
      "required": ["objectApiName", "buttons"]
    },
    "linkedInSalesNavigatorSettings": {
      "id": "linkedInSalesNavigatorSettings",
      "title": "LinkedIn Sales Navigator Settings",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enable LinkedIn Sales Navigator Integration",
          "type": "boolean"
        }
      }
    },
    "loginAsUser": {
      "id": "loginAsUser",
      "title": "Login As User",
      "type": "object",
      "properties": {
        "userAliasOrName": {
          "title": "User Alias or ID",
          "description": "The user alias (Username or Alias field) or the 15/18 character Salesforce User ID (e.g., 005xx0000000123AAA)",
          "type": "string"
        }
      },
      "required": ["userAliasOrName"]
    },
    "logoutLoginAsUser": {
      "id": "logoutLoginAsUser",
      "title": "Logout Login As User",
      "type": "object",
      "properties": {}
    },
    "omniChannelSettings": {
      "id": "omniChannelSettings",
      "title": "Omni-Channel Settings",
      "type": "object",
      "properties": {
        "enableStatusBasedCapacityModel": {
          "title": "Enable Status-Based Capacity Model",
          "description": "Route and track work based on changes to work status and ownership.",
          "type": "boolean"
        }
      }
    },
    "opportunitySplits": {
      "id": "opportunitySplits",
      "title": "OpportunitySplits Settings",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enable Opportunity Splits",
          "description": "Prerequisite: Opportunity Teams must be enabled e.g. by deploying 'Settings:Opportunity' containing `<enableOpportunityTeam>true</enableOpportunityTeam>`.",
          "type": "boolean"
        }
      }
    },
    "permissionSet": {
      "id": "permissionSet",
      "type": "object",
      "properties": {
        "permissionSetName": {
          "title": "Permission Set",
          "description": "The name of the Permission Set to modify",
          "type": "string"
        },
        "servicePresenceStatuses": {
          "allOf": [
            {
              "$ref": "#/definitions/servicePresenceStatuses"
            }
          ]
        }
      },
      "required": ["permissionSetName"]
    },
    "servicePresenceStatuses": {
      "id": "servicePresenceStatuses",
      "title": "Service Presence Statuses",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "picklists": {
      "id": "picklists",
      "title": "Picklists",
      "type": "object",
      "properties": {
        "picklistValues": {
          "title": "Picklist Values",
          "description": "Replace (and delete) picklist values",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/picklistAction"
          }
        },
        "fieldDependencies": {
          "allOf": [
            {
              "$ref": "#/definitions/fieldDependencies"
            }
          ]
        }
      }
    },
    "picklistAction": {
      "id": "picklistAction",
      "type": "object",
      "properties": {
        "metadataType": {
          "description": "the metadata type",
          "type": "string",
          "enum": ["CustomField", "GlobalValueSet", "StandardValueSet"]
        },
        "metadataFullName": {
          "description": "the API name of the CustomField/GlobalValueSet/StandardValueSet",
          "type": "string"
        },
        "value": {
          "description": "the API name of the value",
          "type": "string"
        },
        "newValue": {
          "description": "the API name of the new value, otherwise blank",
          "type": "string"
        },
        "statusCategory": {
          "description": "the Status Category of a new picklist value",
          "type": "string"
        },
        "replaceAllBlankValues": {
          "description": "replace all blank values (mutually exclusive to replacing an old value)",
          "type": "boolean"
        },
        "active": {
          "description": "ensure the picklist value is active/inactive",
          "type": "boolean"
        },
        "absent": {
          "description": "ensure the picklist value is absent/deleted",
          "type": "boolean"
        }
      },
      "required": ["metadataType", "metadataFullName"]
    },
    "fieldDependencies": {
      "description": "Manage (create/modify/delete) Field Dependencies on CustomFields.\nIf a Field Dependency already exists for the dependent field, it will be deleted.",
      "id": "fieldDependencies",
      "title": "Field Dependencies",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/fieldDependency"
      }
    },
    "fieldDependency": {
      "id": "fieldDependency",
      "type": "object",
      "properties": {
        "object": {
          "title": "the API name of the CustomObject",
          "examples": ["Account", "Vehicle__c", "ACME__Vehicle__c"],
          "type": "string"
        },
        "dependentField": {
          "title": "the API name of the CustomField that has its values filtered",
          "examples": ["Gears__c", "ACME__Gears__c"],
          "type": "string"
        },
        "controllingField": {
          "title": "the API name of the CustomField that drives filtering",
          "description": "If this value is null or not set, the Field Dependency will be deleted.",
          "examples": ["Transmission__c", "ACME__Transmission__c", null],
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "providerSearchSettings": {
      "id": "providerSearchSettings",
      "title": "Provider Search Settings",
      "type": "object",
      "properties": {
        "generateDPEDefinition": {
          "title": "Generate DPE Definition",
          "type": "boolean"
        },
        "manualDataSync": {
          "title": "Manual Data Sync",
          "description": "After generating the DPE definition, execute the Data Processing Engine action to run a batch job.",
          "default": false,
          "type": "boolean"
        }
      }
    },
    "recordTypes": {
      "id": "recordTypes",
      "title": "RecordTypes",
      "type": "object",
      "properties": {
        "deletions": {
          "title": "Record Type Deletions",
          "description": "Delete inactive record types",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/recordTypeAction"
          }
        }
      }
    },
    "recordTypeAction": {
      "id": "recordTypeAction",
      "type": "object",
      "properties": {
        "fullName": {
          "description": "the API name of the RecordType",
          "type": "string"
        },
        "replacement": {
          "description": "optional API name of the replacement RecordType",
          "type": "string"
        }
      },
      "required": ["fullName"]
    },
    "relateContactToMultipleAccounts": {
      "id": "relateContactToMultipleAccounts",
      "title": "RelateContactToMultipleAccounts Settings",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enable RelateContactToMultipleAccounts",
          "description": "This allows you to enable the 'Relate contact to multiple Accounts' in the Account settings. Doing this through the metadata API will not always make the AccountContactRelation object available. Enabling the feature using the setup does always work, therefore this plugin.",
          "type": "boolean"
        }
      }
    },
    "reportsAndDashboards": {
      "id": "reportsAndDashboards",
      "title": "Reports & Dashboards",
      "type": "object",
      "properties": {
        "folderSharing": {
          "allOf": [
            {
              "$ref": "#/definitions/folderSharing"
            }
          ]
        }
      }
    },
    "folderSharing": {
      "id": "folderSharing",
      "title": "Folder Sharing",
      "type": "object",
      "properties": {
        "enableEnhancedFolderSharing": {
          "title": "Enable access levels for sharing report and dashboard folders",
          "$comment": "If your organization was created after the Summer ’13 Salesforce release, you already have enhanced folder sharing",
          "type": "boolean"
        }
      }
    },
    "scheduledBatches": {
      "id": "scheduledBatches",
      "title": "Scheduled Batches",
      "type": "object",
      "properties": {
        "jobScheduleNames": {
          "title": "Job Names",
          "description": "Optional. List of batch job names to schedule (matches the Job Name column in the table). When omitted, all checkboxes are checked.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allJobScheduleNames": {
          "title": "All Job Names",
          "description": "Optional. If true, all batch job names are scheduled. Overrides jobScheduleNames.",
          "type": "boolean"
        },
        "namespace": {
          "title": "Namespace",
          "description": "Optional. The namespace of the batch job schedule object. Defaults to 'th_dev'.",
          "type": "string"
        }
      }
    },
    "salesforceCpqConfig": {
      "id": "salesforceCpqConfig",
      "title": "SalesforceCpqConfig Settings",
      "type": "object",
      "properties": {
        "documents": {
          "title": "Documents",
          "type": "object",
          "properties": {
            "documentFolder": {
              "title": "Document Folder",
              "type": "string"
            },
            "hideDocumentName": {
              "title": "Hide Document Name",
              "type": "boolean"
            },
            "fullPagePreview": {
              "title": "Full Page Preview",
              "type": "boolean"
            },
            "excludeHiddenLinesInGroupTotals": {
