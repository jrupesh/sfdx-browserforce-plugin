<apex:page controller="SchedulerConfigurationController" showHeader="true" sidebar="true">
    <apex:form>
        <apex:pageMessages />
        <apex:pageBlock title="Batch Job Scheduler Configuration">
            <apex:pageBlockButtons>
                <apex:commandButton value="Apply Changes" action="{!save}" />
            </apex:pageBlockButtons>
            <apex:pageBlockTable value="{!scheduledApexJobs}" var="job">
                <apex:column headerValue="Id">
                    <apex:outputText value="{!job.schedule.Id}" />
                </apex:column>
                <apex:column headerValue="Scheduled">
                    <apex:inputCheckbox value="{!job.scheduled}" html-data-record-id="{!job.schedule.Id}"/>
                </apex:column>
            </apex:pageBlockTable>
        </apex:pageBlock>
    </apex:form>
</apex:page>