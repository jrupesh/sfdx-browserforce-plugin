{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://github.com/amtrack/sfdx-browserforce-plugin/src/plugins/external-storage-settings/schema.json",
  "title": "External Storage Settings",
  "type": "object",
  "properties": {
    "enable": {
      "title": "Toggle names to enable",
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["AccessFilesInAmazonS3", "UploadFilesToAmazonS3"]
      },
      "uniqueItems": true
    },
    "disable": {
      "title": "Toggle names to disable",
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["AccessFilesInAmazonS3", "UploadFilesToAmazonS3"]
      },
      "uniqueItems": true
    }
  }
}
